# NETRA .gitignore

# Runtime case output (never committed)
data/cases/
# Runtime CSV exports from the dashboard
data/exports/
# Note: data/mock/registry_seed.mat IS committed so the demo dashboard/queue
# are populated on a fresh clone. Regenerate with seedMockRegistry if needed.

# MATLAB autosave / temp
*.asv
*.m~
*.autosave

# MATLAB session/build artefacts
slprj/
codegen/
*.slxc
*.mex*
octave-workspace

# OS cruft
.DS_Store
Thumbs.db

# Large files (>50 MB) must not be committed. Git cannot filter by size in
# .gitignore directly; enforce via a pre-commit check or manually.
# Common large binaries kept out by extension:
*.zip
*.tar
*.tar.gz
*.7z
*.h5
*.onnx
*.pb
*.ckpt
# Model weights over the size limit go to a release/DVC store, not git.
